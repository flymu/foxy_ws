Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic:
        Value: /Odometry
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Keep: 100
      Enabled: true
      Shape: Arrow
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Path
      Name: Path
      Topic:
        Value: /path
        Depth: 5
        Reliability Policy: Best Effort
      Enabled: true
      Color: 0; 255; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: CloudRegistered
      Topic:
        Value: /cloud_registered
        Depth: 5
        Reliability Policy: Best Effort
      Enabled: true
      Style: Points
      Size (m): 0.02
      Color Transformer: Intensity
      Use rainbow?: true
    - Class: rviz_default_plugins/PointCloud2
      Name: MapDecay
      Topic:
        Value: /cloud_registered
        Depth: 5
        Reliability Policy: Best Effort
      Enabled: false
      Style: Points
      Size (m): 0.02
      Queue Size: 400
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_init
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Name: Current View
      Pitch: 0.4
      Yaw: 3.14
