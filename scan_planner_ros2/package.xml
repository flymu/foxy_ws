<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>scan_planner_ros2</name>
  <version>0.1.0</version>
  <description>ROS2 wrapper of SCAN-Planner standalone (de-ROS core): map-frame localization pose + registered cloud in, cmd_vel + plan out.</description>
  <maintainer email="mu@example.com">mu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
